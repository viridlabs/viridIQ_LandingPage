---
import { calendly } from '../data/site';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const links = [
  { href: base, label: 'Home' },
  { href: `${base}work/`, label: 'Work' },
  { href: `${base}about/`, label: 'About' },
  { href: `${base}contact/`, label: 'Contact' },
];
---

<nav class="nav" aria-label="Primary">
  <a class="brand" href={base}>
    <img src={`${base}icon.png`} alt="" width="40" height="40" />
    <span class="wordmark"><span class="virid">Virid</span>IQ</span>
  </a>
  <div class="nav-links">
    {
      links.map((link) => (
        <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </div>
  <a class="button" href={calendly}>Book a Discovery Call</a>
</nav>
